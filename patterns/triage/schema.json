{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision", "novel", "significant", "duplicate_of", "reason", "reason_code"],
  "additionalProperties": false,
  "properties": {
    "decision": { "enum": ["process", "skip"] },
    "novel": { "type": "boolean" },
    "significant": { "type": "boolean" },
    "duplicate_of": { "type": ["string", "null"] },
    "reason": { "type": "string" },
    "reason_code": {
      "type": ["string", "null"],
      "enum": [
        "vendor_marketing",
        "not_an_incident",
        "off_topic",
        "speculation",
        "low_severity",
        "duplicate",
        null
      ]
    }
  }
}
